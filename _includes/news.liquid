<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% assign current_news = news | where_exp: "item", "item.archived != true" %}
    {% assign previous_news = news | where: "archived", true %}
    {% assign current_news_size = current_news | size %}

    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and current_news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = current_news_size %}
        {% endif %}
        {% for item in current_news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>

    {% if previous_news != blank %}
      <details class="news-archive">
        <summary>
          <span class="news-archive-title">Previous</span>
          <span class="news-archive-count">({{ previous_news | size }})</span>
        </summary>
        <div class="table-responsive">
          <table class="table table-sm table-borderless">
            {% for item in previous_news %}
              <tr>
                <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </table>
        </div>
      </details>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
